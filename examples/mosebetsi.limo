; mosebetsi.limo  --  procedure call, logic ops, equal/not-equal branches
; Expected: nt0 = 24, nk1 = 8, nk2 = 26, nk3 = 18 ; mem[0]=24 mem[4]=18
        eketsana nt0, letho, 12     ; argument
        tsamaea  khutlo, habeli     ; call habeli (khutlo = return address)
        eketsana nk0, letho, 10
        le       nk1, nt0, nk0      ; 24 AND 10 = 8
        kapa     nk2, nt0, nk0      ; 24 OR  10 = 26
        tlosa    nk3, nk2, nk1      ; 26 - 8   = 18
        kenya    nt0, 0(letho)
        kenya    nk3, 4(letho)
        lekana   nk1, nk1, qetello  ; 8 == 8 -> taken
        eketsana nk3, letho, 99     ; skipped
qetello: ema
habeli: eketsa   nt0, nt0, nt0      ; nt0 = 2 * nt0
        khutla                      ; return
